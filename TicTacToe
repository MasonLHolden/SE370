import java.util.Scanner;


public class Main {
    public static void main(String[] args) {
        //initialize the TicTacToe game
        TicTacToe game = new TicTacToe();

        //Play game

        game.play();
        
    }
}

//constructor
class TicTacToe {
    private static final int BOARDSIZE = 3;
    private char[][] board = new char[BOARDSIZE][BOARDSIZE];

    private enum Status {
        WIN,
        DRAW,
        CONTINUE
    }

    private boolean firstPlayer;
    private boolean gameOver;

    public TicTacToe() {
        firstPlayer = true;
        gameOver = false;

    //Nested loop to iterate through the board matrix and initiate each square to an empty space ' '

        for(int row = 0; row < BOARDSIZE; row++){
            for(int col = 0; col < BOARDSIZE; col++){
                board[row][col]=' ';
                }
            }
            
        }

    public void play() {

    Scanner input = new Scanner(System.in);

    char player = 'O';

    while (!gameOver) {
        
        printBoard();
        System.out.println("Player " + player + "'s turn.");
        
        System.out.print("Player " + player +
                         ": Enter row ( 0, 1 or 2 ): ");
        int row = input.nextInt();

        System.out.print("Player " + player +
                         ": Enter column ( 0, 1 or 2 ): ");
        int column = input.nextInt();

        if (!validMove(row, column)) {
            System.out.println("Invalid move. Try again.");
            continue;
        }

        // Place the player's symbol
        board[row][column] = player;

        // Check game status
        Status status = gameStatus();

        if (status == Status.WIN || status == Status.DRAW) {

            gameOver = true;

            printBoard();
            printStatus(player);

        }
        else {

            // Switch players
            if (player == 'O') {
                player = 'X';
            }
            else {
                player = 'O';
            }
        }
    }

    input.close();
}

    //printstatus(in player:int)
    private void printStatus(char player){

        Status status = gameStatus();

        if(status == Status.WIN){
            System.out.println("Player "+player+" wins.");
        }
        else if (status == Status.DRAW){
            System.out.println("DRAW");
        }
    }
    
    //gameStatus(): WIN, DRAW, CONTINUE :status
   private Status gameStatus() {

    // Check rows
    for (int row = 0; row < BOARDSIZE; row++) {

        if (board[row][0] != ' ' && board[row][0] == board[row][1] && board[row][1] == board[row][2]) {
            return Status.WIN;
        }
    }

    // Check columns
    for (int column = 0; column < BOARDSIZE; column++) {

        if (board[0][column] != ' ' && board[0][column] == board[1][column] && board[1][column] == board[2][column]) {
            return Status.WIN;
        }
    }

    // Check diagonal: top-left to bottom-right
    if (board[0][0] != ' ' && board[0][0] == board[1][1] && board[1][1] == board[2][2]) { 
        return Status.WIN;
    }

    // Check diagonal: top-right to bottom-left
    if (board[0][2] != ' ' && board[0][2] == board[1][1] && board[1][1] == board[2][0]) {
        return Status.WIN;
    }

    // Check if the board is full
    for (int row = 0; row < BOARDSIZE; row++) {

        for (int column = 0; column < BOARDSIZE; column++) {

            if (board[row][column] == ' ') {
                return Status.CONTINUE;
            }
        }
    }

    return Status.DRAW;
}

    //print board()
    public void printBoard(){

     for (int row = 0; row < BOARDSIZE; row++) {
        System.out.print("  ");

        for (int column = 0; column < BOARDSIZE; column++) {
    printSymbol(column, board[row][column]);
        }

        System.out.println();

        if (row < BOARDSIZE - 1) {
            System.out.println(" ---+---+---");
            }
        }
    }

    //print symbol
    private void printSymbol(int col,char value){
        System.out.print(value);

        if(col < BOARDSIZE - 1){
            System.out.print(" | ");
        }
        
    }

    //validmove(in row:int,in column:int):bool
    private boolean validMove(int row, int column) {

    // Check row 
    if (row < 0 || row >= BOARDSIZE) {
        return false;
    }

    // Check col
    if (column < 0 || column >= BOARDSIZE) {
        return false;
    }

    // Check if square is already occupied
    if (board[row][column] != ' ') {
        return false;
    }

    return true;
}
    
}
